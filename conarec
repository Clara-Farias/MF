<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Totem · Ativação CONAREC</title>
<style>
@font-face{
  font-family:'Fraunces';
  src:url(data:font/woff2;base64,) format('woff2-variations'),
      url(data:font/woff2;base64,) format('woff2');
  font-weight:400 900;
  font-style:normal;
  font-display:swap;
}
@font-face{
  font-family:'Manrope';
  src:url(data:font/woff2;base64,) format('woff2');
  font-weight:400;font-style:normal;font-display:swap;
}
@font-face{
  font-family:'Manrope';
  src:url(data:font/woff2;base64,) format('woff2');
  font-weight:500;font-style:normal;font-display:swap;
}
@font-face{
  font-family:'Manrope';
  src:url(data:font/woff2;base64,) format('woff2');
  font-weight:600;font-style:normal;font-display:swap;
}
@font-face{
  font-family:'Manrope';
  src:url(data:font/woff2;base64,) format('woff2');
  font-weight:700 800;font-style:normal;font-display:swap;
}
</style>
<style>
  :root{
    --bg:#F2EEE1;
    --paper:#FAF8F1;
    --ink:#132318;
    --ink-soft:#5B6A5C;
    --brand:#1B5E20;
    --brand-deep:#0E3413;
    --brand-light:#D9ECD1;
    --accent:#E7A33E;
    --accent-deep:#C97A2B;
    --line:#DCD5C1;
    --card:#FFFFFF;
    --lime:#9CDB4A;
    --dark-bg:#0F2C1C;
    --dark-card:#17392A;
    --dark-line:rgba(255,255,255,.14);
    --dark-text-soft:rgba(214,232,214,.75);
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html,body{height:100%;}
  body{
    font-family:'Manrope',sans-serif;
    background:
      radial-gradient(circle at 20% 15%, #3a3a32 0%, #1c1c18 55%, #0d0d0b 100%);
    display:flex;align-items:center;justify-content:center;
    min-height:100vh;
    padding:40px 20px;
  }

  /* ===== Corpo físico do totem ===== */
  .kiosk{
    position:relative;
    width:400px;
    padding:22px 22px 40px;
    border-radius:38px;
    background:linear-gradient(160deg,#3d3d36 0%,#232320 45%,#141412 100%);
    box-shadow:
      0 60px 100px -20px rgba(0,0,0,.65),
      inset 0 1px 0 rgba(255,255,255,.06);
  }
  .kiosk::before{
    content:"";position:absolute;top:10px;left:50%;transform:translateX(-50%);
    width:8px;height:8px;border-radius:50%;
    background:radial-gradient(circle at 35% 35%, #6b6b62, #1c1c18);
  }
  .kiosk::after{
    content:"MEIRELES & FREITAS · COBRANÇA DIGITAL";
    position:absolute;bottom:14px;left:0;right:0;text-align:center;
    font-size:8.5px;letter-spacing:.16em;color:#8a8a7e;font-weight:600;
  }

  .screenwrap{
    position:relative;
    border-radius:22px;
    overflow:hidden;
    box-shadow:inset 0 0 0 2px rgba(0,0,0,.35);
  }
  .totem{
    width:100%;height:720px;
    background:var(--bg);
    position:relative;
    overflow:hidden;
  }
  /* textura de grade sutil — remete a rede/medição de energia */
  .totem::before{
    content:"";position:absolute;top:0;right:0;bottom:0;left:0;
    background-image:radial-gradient(circle, rgba(27,94,32,.08) 1px, transparent 1px);
    background-size:18px 18px;
    pointer-events:none;
  }
  /* reflexo de vidro */
  .screenwrap::after{
    content:"";position:absolute;top:0;right:0;bottom:0;left:0;
    background:linear-gradient(115deg, rgba(255,255,255,.10) 0%, rgba(255,255,255,0) 22%);
    pointer-events:none;
  }

  .screen{
    position:absolute;top:0;right:0;bottom:0;left:0;z-index:1;
    display:flex;flex-direction:column;
    padding:38px 26px 26px;
    opacity:0;pointer-events:none;
    transform:translateX(20px);
    transition:opacity .4s ease, transform .4s ease;
  }
  .screen.active{opacity:1;pointer-events:auto;transform:translateX(0);}

  .eyebrow{
    font-size:11px;letter-spacing:.14em;text-transform:uppercase;
    color:var(--brand);font-weight:700;margin-bottom:10px;
  }
  h1{
    font-family:'Fraunces',serif;font-weight:600;
    color:var(--ink);line-height:1.06;letter-spacing:-.01em;
  }

  /* ===== Tela 0 — Boas-vindas ===== */
  #sentry{padding:0;overflow:hidden;background:#0F2C1C;}

  .s0-bg{
    position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%;
    object-fit:cover;object-position:center top;z-index:0;
  }
  .s0-scrim{
    position:absolute;top:0;right:0;bottom:0;left:0;z-index:1;
    background:linear-gradient(180deg,
      rgba(10,22,15,.65) 0%, rgba(10,22,15,.15) 20%,
      rgba(10,22,15,0) 42%, rgba(10,22,15,.55) 66%,
      rgba(10,22,15,.94) 82%, rgba(9,20,13,.98) 100%);
  }
  .s0-content{
    position:relative;z-index:2;height:100%;
    display:flex;flex-direction:column;
    padding:26px 26px 30px;text-align:center;
  }
  .logo-svg{display:flex;align-items:center;justify-content:center;}
  .logo-svg img{height:22px;width:auto;}

  .s0-bottom{margin-top:auto;}
  .marly-tag{
    color:rgba(255,255,255,.9);font-size:11px;font-weight:700;letter-spacing:.14em;
    text-transform:uppercase;margin:0 0 8px;
  }
  #sentry h1{
    font-family:'Fraunces',serif;font-weight:600;color:#fff;
    font-size:26px;line-height:1.12;margin:0 0 10px;letter-spacing:-.01em;
  }
  #sentry p{color:rgba(214,232,214,.85);font-size:13.5px;max-width:250px;margin:0 auto 22px;line-height:1.5;}

  .tap-btn{
    border:none;padding:17px 40px;border-radius:100px;
    font-size:15px;font-weight:800;cursor:pointer;
    font-family:'Manrope',sans-serif;letter-spacing:.01em;
  }
  .tap-btn.lime{
    background:#9CDB4A;color:#16240B;
    box-shadow:0 12px 26px -8px rgba(156,219,74,.6);
  }
  .tap-hint{color:rgba(255,255,255,.5);font-size:11.5px;margin-top:14px;letter-spacing:.04em;}

  /* ===== Escolha do canal — blocos editoriais ===== */
  #schoice{padding:0;background:var(--bg);}
  .rh-top{padding:28px 26px 24px;}
  .rh-header{
    display:flex;justify-content:space-between;align-items:center;
    font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
    color:var(--ink-soft);margin-bottom:26px;
  }
  .rh-title{
    font-family:'Manrope',sans-serif;font-weight:800;color:var(--ink);
    font-size:44px;line-height:.94;letter-spacing:-.02em;margin-bottom:14px;
  }
  .rh-sub{font-size:14px;color:var(--ink-soft);line-height:1.45;max-width:280px;}

  .rh-block{
    position:relative;flex:1;overflow:hidden;cursor:pointer;
    padding:22px 26px;display:flex;flex-direction:column;justify-content:flex-end;
  }
  .rh-block.lime{background:var(--lime);}
  .rh-block.dark{background:var(--dark-bg);}
  .rh-circle{
    position:absolute;top:-40px;right:-50px;width:180px;height:180px;border-radius:50%;
    background:repeating-linear-gradient(45deg, rgba(15,44,28,.13) 0 6px, transparent 6px 12px);
  }
  .rh-eyebrow{
    font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
    margin-bottom:auto;position:relative;z-index:1;
  }
  .rh-block.lime .rh-eyebrow{color:var(--brand-deep);}
  .rh-block.dark .rh-eyebrow{color:var(--lime);}
  .rh-block h2{
    font-family:'Manrope',sans-serif;font-weight:800;font-size:26px;line-height:1.02;
    letter-spacing:-.01em;margin:16px 0 8px;position:relative;z-index:1;
  }
  .rh-block.lime h2{color:var(--brand-deep);}
  .rh-block.dark h2{color:#fff;}
  .rh-block p{font-size:13px;line-height:1.4;position:relative;z-index:1;}
  .rh-block.lime p{color:rgba(15,44,28,.75);}
  .rh-block.dark p{color:var(--dark-text-soft);}

  .ghost-btn{
    background:transparent;border:1.5px solid var(--line);color:var(--ink);
    padding:14px 30px;border-radius:100px;font-size:13.5px;font-weight:700;
    cursor:pointer;font-family:'Manrope',sans-serif;
  }
  .ghost-btn.light{border-color:rgba(255,255,255,.35);color:#fff;}

  /* ===== Voz — card de vídeo 16:9 + player em fluxo normal ===== */
  #svoice{background:var(--dark-bg);text-align:left;padding-top:24px;}
  #svoice .eyebrow{color:var(--lime);margin-top:22px;}
  #svoice h1{color:#fff;font-size:24px;margin-bottom:8px;}
  #svoice .sub{color:var(--dark-text-soft);font-size:13px;margin-bottom:18px;}

  .voice-topbar{display:flex;align-items:center;gap:8px;}
  .voice-topbar span{font-size:10px;font-weight:700;letter-spacing:.08em;color:var(--dark-text-soft);text-transform:uppercase;}
  .step-dashes{display:flex;gap:4px;}
  .step-dashes i{width:16px;height:3px;border-radius:3px;background:var(--dark-line);display:block;}
  .step-dashes i.on{background:var(--lime);}

  .voice-panel{
    position:relative;flex:1;border-radius:20px;overflow:hidden;
    background:#0B2417;margin-bottom:18px;min-height:340px;
    box-shadow:0 16px 30px -18px rgba(0,0,0,.55);
  }
  .voice-panel-video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
  .voice-panel-scrim{
    position:absolute;inset:0;
    background:linear-gradient(180deg, rgba(9,20,13,.35) 0%, rgba(9,20,13,0) 30%, rgba(9,20,13,.4) 62%, rgba(8,17,12,.92) 100%);
  }
  .voice-live{
    position:absolute;top:16px;left:16px;z-index:2;
    display:flex;align-items:center;gap:7px;
    background:rgba(9,20,13,.6);border:1px solid var(--dark-line);
    padding:6px 12px;border-radius:100px;
    font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--dark-text-soft);
  }
  .live-dot{width:6px;height:6px;border-radius:50%;background:var(--dark-text-soft);}
  .voice-live.on .live-dot{background:var(--lime);animation:liveblink 1.2s ease-in-out infinite;}
  .voice-live.on{color:#fff;}
  @keyframes liveblink{0%,100%{opacity:1;}50%{opacity:.35;}}

  .voice-panel-bottom{position:absolute;left:0;right:0;bottom:0;z-index:2;padding:20px;}
  .voice-name{font-family:'Fraunces',serif;font-weight:600;color:#fff;font-size:16px;margin-bottom:14px;}
  .voice-controls{display:flex;align-items:center;gap:14px;}
  .play-btn{
    width:56px;height:56px;border-radius:50%;border:none;flex-shrink:0;
    background:var(--lime);color:var(--brand-deep);
    display:flex;align-items:center;justify-content:center;cursor:pointer;
  }
  .play-btn svg{margin-left:2px;}
  .play-btn #iconPause{margin-left:0;}
  .voice-progress{flex:1;min-width:0;}
  .player-bar{
    width:100%;height:5px;border-radius:6px;background:rgba(255,255,255,.2);
    cursor:pointer;overflow:hidden;margin-bottom:6px;
  }
  .player-bar-fill{height:100%;width:0%;background:var(--lime);border-radius:6px;}
  .player-time{
    width:100%;display:flex;justify-content:space-between;
    font-size:11px;color:var(--dark-text-soft);font-variant-numeric:tabular-nums;
  }

  .voice-actions.two-col{display:flex;gap:10px;margin-top:0;}
  .voice-actions.two-col button{flex:1;width:auto;text-align:center;padding-left:12px;padding-right:12px;}

  /* ===== Texto — chat simulado ===== */
  #schat{background:var(--dark-bg);text-align:left;padding-top:24px;}
  #schat .eyebrow{color:var(--lime);margin-top:22px;}
  #schat h1{color:#fff;font-size:26px;margin-bottom:8px;}
  #schat .sub{color:var(--dark-text-soft);font-size:13px;margin-bottom:20px;}

  .chat-wrap{display:flex;flex-direction:column;gap:10px;overflow-y:auto;margin-bottom:18px;scrollbar-width:none;max-height:160px;}
  .chat-wrap::-webkit-scrollbar{display:none;}
  .chat-wrap.compact{margin-bottom:16px;}
  .bubble{
    max-width:88%;padding:12px 15px;border-radius:14px;
    font-size:13px;line-height:1.4;
  }
  .bubble.bot{
    background:var(--dark-card);border:1px solid var(--dark-line);color:var(--dark-text-soft);
    align-self:flex-start;
  }
  .bubble.bot b{color:#fff;}
  .bubble.user{
    background:var(--lime);color:var(--brand-deep);font-weight:600;
    align-self:flex-end;
  }

  .qr-card{
    position:relative;z-index:2;text-decoration:none;
    background:var(--paper);border-radius:18px;
    padding:16px;display:flex;flex-direction:column;align-items:center;text-align:center;
    margin-top:auto;margin-bottom:16px;
  }
  .qr-img{width:112px;height:112px;border-radius:8px;margin-bottom:10px;}
  .qr-title{font-family:'Manrope',sans-serif;font-weight:800;color:var(--ink);font-size:16px;margin-bottom:6px;}
  .qr-caption{font-size:11.5px;color:var(--ink-soft);line-height:1.4;max-width:220px;}

  /* ===== Perfis de cliente — abas com foco único ===== */
  #sprofile{justify-content:flex-start;background:var(--dark-bg);text-align:left;padding-top:24px;}
  #sprofile .eyebrow{color:var(--lime);margin-top:22px;}
  #sprofile h1{color:#fff;font-size:26px;margin-bottom:18px;}

  .ptabs{
    display:flex;gap:4px;background:rgba(0,0,0,.22);border-radius:100px;padding:4px;margin-bottom:18px;
  }
  .ptab{
    flex:1;appearance:none;border:none;border-radius:100px;padding:10px 4px;cursor:pointer;
    font-family:'Manrope',sans-serif;font-size:10.5px;font-weight:700;line-height:1.2;
    background:transparent;color:#8CA395;transition:background .18s, color .18s;
  }
  .ptab.on{background:#E3B25A;color:#12211B;}

  .pfocus{display:flex;flex-direction:column;gap:14px;flex:1;min-height:0;overflow-y:auto;}
  .pfocus-hero{
    position:relative;width:100%;aspect-ratio:16/9;border-radius:20px;overflow:hidden;
    background:#16362A;border:1.5px solid;
  }
  .pfocus-video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .25s;}
  .pfocus-video.on{opacity:1;}
  .pfocus-badge{
    position:absolute;top:12px;left:12px;font-size:9.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;
    color:#12211B;padding:5px 9px;border-radius:6px;
  }
  #sprofile h2{margin:0;font-family:'Fraunces',serif;font-size:23px;font-weight:600;color:#fff;line-height:1.15;}
  #sprofile .pfocus p{margin:0;font-size:14px;line-height:1.5;color:var(--dark-text-soft);}
  .pfocus-facts{display:flex;flex-direction:column;gap:8px;}
  .pfocus-fact{display:flex;align-items:center;gap:10px;font-size:13.5px;color:#C0D2C5;}
  .pfocus-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}

  /* ===== Player — contexto de perfil ===== */
  .voice-actions{margin-top:auto;padding-top:16px;display:flex;flex-direction:column;gap:10px;width:100%;}

  /* ===== Resultado / prova social ===== */
  #sresult{background:var(--dark-bg);}
  #sresult h1{font-size:23px;margin-bottom:5px;color:#fff;}
  #sresult .sub{color:var(--dark-text-soft);font-size:13.5px;margin-bottom:20px;}
  .result-stat{
    background:var(--lime);border-radius:18px;padding:24px;text-align:center;margin-bottom:18px;
    position:relative;
  }
  .result-icon{
    width:34px;height:34px;border-radius:50%;background:rgba(15,44,28,.14);
    display:flex;align-items:center;justify-content:center;margin:0 auto 10px;
    color:var(--brand-deep);
  }
  .result-number{font-family:'Fraunces',serif;font-size:40px;font-weight:700;color:var(--brand-deep);line-height:1;margin-bottom:6px;}
  .result-label{color:var(--brand-deep);opacity:.8;font-size:12px;line-height:1.4;max-width:220px;margin:0 auto;font-weight:600;}
  .result-note{color:var(--dark-text-soft);font-size:10.5px;text-align:center;margin:-10px 0 18px;font-style:italic;}
  .result-list{display:flex;flex-direction:column;gap:10px;margin-bottom:18px;}
  .result-item{
    display:flex;gap:10px;align-items:flex-start;
    background:var(--dark-card);border:1px solid var(--dark-line);border-radius:14px;padding:12px 14px;
  }
  .result-dot{width:7px;height:7px;border-radius:50%;background:var(--lime);margin-top:5px;flex-shrink:0;}
  .result-item p{font-size:12px;color:var(--dark-text-soft);line-height:1.4;}
  .result-item p b{color:#fff;}
</style>
</head>
<body>
<div class="kiosk">
  <div class="screenwrap">
    <div class="totem">

      <div class="screen" id="sprofile">
        <div class="voice-topbar">
          <span>Passo 2 de 3</span>
          <div class="step-dashes"><i class="on"></i><i class="on"></i><i></i></div>
        </div>

        <h1>Qual a sua<br>situação?</h1>

        <div class="ptabs">
          <button class="ptab on" id="ptab-p1" onclick="focusProfile('p1')">Promessa A</button>
          <button class="ptab" id="ptab-p5" onclick="focusProfile('p5')">Promessa B</button>
          <button class="ptab" id="ptab-p4" onclick="focusProfile('p4')">Alegação</button>
        </div>

        <div class="pfocus">
          <div class="pfocus-hero" id="pfocusHero" style="border-color:#E3B25A80;">
            <video id="pfocusVideoA" class="pfocus-video on" autoplay muted loop playsinline>
              <source src="data:video/webm;base64," type="video/webm">
            </video>
            <video id="pfocusVideoC" class="pfocus-video" autoplay muted loop playsinline>
              <source src="data:video/webm;base64," type="video/webm">
            </video>
            <video id="pfocusVideoB" class="pfocus-video" autoplay muted loop playsinline>
              <source src="data:video/webm;base64," type="video/webm">
            </video>
          </div>

          <h2 id="pfocusTitle">Promessa de pagamento</h2>
          <p id="pfocusDesc">Cliente se compromete a quitar em breve. Vale confirmar data e forma de pagamento.</p>

          <div class="pfocus-facts" id="pfocusFacts">
            <div class="pfocus-fact"><span class="pfocus-dot" style="background:#E3B25A;"></span><span>Comprometeu-se a pagar</span></div>
            <div class="pfocus-fact"><span class="pfocus-dot" style="background:#E3B25A;"></span><span>Combinou uma data</span></div>
            <div class="pfocus-fact"><span class="pfocus-dot" style="background:#E3B25A;"></span><span>Nome pode ser preservado</span></div>
          </div>
        </div>

        <div class="voice-actions">
          <button class="tap-btn lime" onclick="selectProfile(currentFocus)">Ouvir a proposta</button>
          <button class="ghost-btn light" onclick="go('schoice')">Voltar</button>
        </div>
      </div>

      <div class="screen active" id="sentry">
        <video class="s0-bg" autoplay muted loop playsinline><source src="data:video/webm;base64," type="video/webm"></video>
        <div class="s0-scrim"></div>

        <div class="s0-content">
          <div class="logo-svg"><img src="data:image/png;base64," alt="Meireles &amp; Freitas"></div>

          <div class="s0-bottom">
            <div class="marly-tag">Marly · Atendente Virtual</div>
            <h1>Conheça a nova era<br>da cobrança digital</h1>
            <p>Inicie sua experiência e descubra como a IACOB transforma o atendimento.</p>
            <button class="tap-btn lime" onclick="go('schoice')">Iniciar experiência</button>
          </div>
        </div>
      </div>

      <div class="screen" id="schoice">
        <div class="rh-top">
          <h1 class="rh-title">Resolva<br>hoje.</h1>
          <p class="rh-sub">Sua dívida com desconto, decidida em dois minutos. <b>Clique e veja.</b></p>
        </div>

        <div class="rh-block lime" onclick="go('sprofile')">
          <div class="rh-circle"></div>
          <div class="rh-eyebrow">Voz · Aqui no totem</div>
          <h2>Falar com<br>a Marly</h2>
          <p>Ela explica sua proposta em voz alta, agora.</p>
        </div>

        <div class="rh-block dark" onclick="go('schat')">
          <div class="rh-eyebrow">Texto · No seu celular</div>
          <h2>Levar no<br>WhatsApp</h2>
          <p>A IACOB continua com você depois daqui.</p>
        </div>
      </div>

      <div class="screen" id="svoice">
        <div class="voice-topbar">
          <span>Passo 3 de 3</span>
          <div class="step-dashes"><i class="on"></i><i class="on"></i><i class="on"></i></div>
        </div>

        <div class="eyebrow">Proposta</div>
        <h1>Marly explica<br>o seu caso</h1>

        <div class="voice-panel">
          <video class="voice-panel-video" autoplay muted loop playsinline>
            <source src="data:video/webm;base64," type="video/webm">
          </video>
          <div class="voice-panel-scrim"></div>

          <div class="voice-live" id="voiceLive"><span class="live-dot"></span>Falando agora</div>

          <div class="voice-panel-bottom">
            <div class="voice-name">Marly</div>
            <div class="voice-controls">
              <button class="play-btn" id="playBtn" onclick="togglePlay()">
                <svg id="iconPlay" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                <svg id="iconPause" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="display:none"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
              </button>
              <div class="voice-progress">
                <div class="player-bar" id="playerBar"><div class="player-bar-fill" id="playerFill"></div></div>
                <div class="player-time"><span id="tCurrent">0:00</span><span id="tTotal">0:00</span></div>
              </div>
            </div>
          </div>
        </div>

        <audio id="marlyAudio" preload="none">
          <source src="data:audio/mpeg;base64," type="audio/mpeg">
        </audio>

        <div class="voice-actions two-col">
          <button class="ghost-btn light" onclick="resetVoice(); go('sprofile')">Outra situação</button>
          <button class="tap-btn lime" onclick="go('sresult')">Ver a proposta</button>
        </div>
      </div>

      <div class="screen" id="schat">
        <div class="voice-topbar">
          <span>Passo 3 de 3</span>
          <div class="step-dashes"><i class="on"></i><i class="on"></i><i class="on"></i></div>
        </div>

        <div class="eyebrow">Final · WhatsApp</div>
        <h1>Continue no<br>seu celular.</h1>
        <p class="sub">A conversa abre no WhatsApp com seu caso já carregado.</p>

        <div class="chat-wrap compact">
          <div class="bubble bot">Oi, sou a IACOB. Vi que seu caso é <b>atrasei um mês</b>.</div>
          <div class="bubble user">Quero ver a proposta.</div>
          <div class="bubble bot">Certo. Levo 3 perguntas rápidas e mostro o valor.</div>
        </div>

        <a class="qr-card" href="https://wa.me/558596285545?text=Oi!%20Vim%20do%20estande%20da%20Meireles%20%26%20Freitas%20no%20CONAREC%20e%20quero%20conhecer%20a%20IACOB." target="_blank" rel="noopener">
          <img class="qr-img" src="data:image/png;base64," alt="QR Code WhatsApp IACOB">
          <div class="qr-title">Escaneie para continuar</div>
          <p class="qr-caption">A câmera do celular reconhece o código. Nada é cobrado.</p>
        </a>

        <button class="ghost-btn light" onclick="go('sentry')" style="margin-top:auto;">Começar de novo</button>
      </div>

      <div class="screen" id="sresult">
        <div class="eyebrow">Resultado</div>
        <h1>Negociar funciona</h1>
        <p class="sub">É assim que fica para clientes no mesmo perfil que o seu.</p>

        <div class="result-stat">
          <div class="result-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="0.5" fill="currentColor"/></svg>
          </div>
          <div class="result-number">94%</div>
          <div class="result-label">dos clientes que negociam com a Marly evitam a negativação</div>
        </div>
        <div class="result-note">Número ilustrativo, para fins de demonstração</div>

        <div class="result-list">
          <div class="result-item">
            <div class="result-dot"></div>
            <p>Cliente do perfil <b>Imprevisto</b> quitou a fatura em 2 dias após negociar</p>
          </div>
          <div class="result-item">
            <div class="result-dot"></div>
            <p>Cliente do perfil <b>Situação crítica</b> parcelou em 3x e regularizou o cadastro</p>
          </div>
          <div class="result-item">
            <div class="result-dot"></div>
            <p>Cliente do perfil <b>Recorrente</b> unificou 4 faturas em uma só negociação</p>
          </div>
        </div>

        <button class="tap-btn lime" onclick="go('sentry')" style="margin-top:auto;">Reiniciar experiência</button>
      </div>

    </div>
  </div>
</div>

<script>
  function go(id){
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    document.getElementById(id).classList.add('active');
  }

  /* ===== Perfis de cliente =====
     Hoje todos os perfis tocam o mesmo áudio (o que vocês mandaram).
     Quando tiver um áudio gravado por perfil, é só trocar o <source> dentro de
     #marlyAudio para cada perfil aqui (ex.: um objeto AUDIO_MAP = {p1:'data:audio/mpeg;base64,...', ...}
     e setar audio.querySelector('source').src = AUDIO_MAP[id] dentro desta função). */
  const PROFILE_NAMES = {
    p1: 'Prometo pagar em breve · cerca de 1 minuto. Você pode pausar quando quiser.',
    p5: 'Prometo pagar em breve · cerca de 1 minuto. Você pode pausar quando quiser.',
    p4: 'Já paguei, tenho o comprovante · cerca de 1 minuto. Você pode pausar quando quiser.'
  };

  const FOCUS_DATA = {
    p1: {
      tab: 'ptab-p1', video: 'pfocusVideoA', accent: '#E3B25A',
      badge: 'Compromisso assumido', title: 'Promessa de pagamento',
      desc: 'Cliente se compromete a quitar em breve. Vale confirmar data e forma de pagamento.',
      facts: ['Comprometeu-se a pagar', 'Combinou uma data', 'Nome pode ser preservado']
    },
    p5: {
      tab: 'ptab-p5', video: 'pfocusVideoC', accent: '#E3B25A',
      badge: 'Compromisso assumido', title: 'Promessa de pagamento',
      desc: 'Cliente se compromete a quitar em breve. Vale confirmar data e forma de pagamento.',
      facts: ['Comprometeu-se a pagar', 'Combinou uma data', 'Nome pode ser preservado']
    },
    p4: {
      tab: 'ptab-p4', video: 'pfocusVideoB', accent: '#E27A6B',
      badge: 'Precisa verificar', title: 'Alegação de pagamento',
      desc: 'Cliente diz que já pagou, mas não há registro. Peça o comprovante para confirmar.',
      facts: ['Diz que já pagou', 'Sem comprovante localizado', 'Precisa de verificação']
    }
  };
  let currentFocus = 'p1';

  function focusProfile(id){
    currentFocus = id;
    const d = FOCUS_DATA[id];
    document.querySelectorAll('.ptab').forEach(t => t.classList.remove('on'));
    document.getElementById(d.tab).classList.add('on');
    document.querySelectorAll('.pfocus-video').forEach(v => v.classList.remove('on'));
    document.getElementById(d.video).classList.add('on');
    document.getElementById('pfocusHero').style.borderColor = d.accent + '80';
    document.getElementById('pfocusTitle').textContent = d.title;
    document.getElementById('pfocusDesc').textContent = d.desc;
    document.getElementById('pfocusFacts').innerHTML = d.facts.map(f =>
      `<div class="pfocus-fact"><span class="pfocus-dot" style="background:${d.accent};"></span><span>${f}</span></div>`
    ).join('');
  }

  const AUDIO_MAP = {
    p1: 'data:audio/mpeg;base64,',
    p5: 'data:audio/mpeg;base64,',
    p4: 'data:audio/mpeg;base64,'
  };

  function selectProfile(id){
    if(AUDIO_MAP[id]){
      audio.querySelector('source').src = AUDIO_MAP[id];
      audio.load();
    }
    resetVoice();
    go('svoice');
  }

  /* ===== Carrossel de entrada — pontinhos ===== */
  const cheroCarousel = document.getElementById('cheroCarousel');
  const cheroDots = document.querySelectorAll('#cheroDots span');
  if(cheroCarousel){
    cheroCarousel.addEventListener('scroll', () => {
      const cardWidth = cheroCarousel.scrollWidth / cheroDots.length;
      const idx = Math.round(cheroCarousel.scrollLeft / cardWidth);
      cheroDots.forEach((d,i) => d.classList.toggle('on', i === idx));
    });
  }

  /* ===== Player de áudio da Marly ===== */
  const audio = document.getElementById('marlyAudio');
  const iconPlay = document.getElementById('iconPlay');
  const iconPause = document.getElementById('iconPause');
  const bar = document.getElementById('playerBar');
  const fill = document.getElementById('playerFill');
  const tCurrent = document.getElementById('tCurrent');
  const tTotal = document.getElementById('tTotal');

  function formatTime(s){
    if(!isFinite(s)) return '0:00';
    const m = Math.floor(s/60), sec = Math.floor(s%60);
    return m + ':' + String(sec).padStart(2,'0');
  }

  function togglePlay(){
    if(audio.paused){ audio.play(); }
    else { audio.pause(); }
  }

  const voiceLive = document.getElementById('voiceLive');

  audio.addEventListener('play', () => {
    iconPlay.style.display='none'; iconPause.style.display='block';
    if(voiceLive) voiceLive.classList.add('on');
  });
  audio.addEventListener('pause', () => {
    iconPlay.style.display='block'; iconPause.style.display='none';
    if(voiceLive) voiceLive.classList.remove('on');
  });
  audio.addEventListener('loadedmetadata', () => { tTotal.textContent = formatTime(audio.duration); });
  audio.addEventListener('timeupdate', () => {
    tCurrent.textContent = formatTime(audio.currentTime);
    fill.style.width = (audio.currentTime / audio.duration * 100) + '%';
  });
  audio.addEventListener('ended', () => { pulse.classList.remove('on'); });

  bar.addEventListener('click', (e) => {
    const rect = bar.getBoundingClientRect();
    const pct = (e.clientX - rect.left) / rect.width;
    if(isFinite(audio.duration)) audio.currentTime = pct * audio.duration;
  });

  function resetVoice(){
    audio.pause();
    audio.currentTime = 0;
  }
</script>
</body>
</html>
